[Unit]
Description=Private EVS operations API
After=network.target

[Service]
Type=simple
User=evsuser
WorkingDirectory=/local/content/evsrestapi-operations
ExecStart=/bin/bash /local/content/evsrestapi-operations/bin/evsrestapi-operations foreground
KillMode=mixed
# The JVM exits with 143 after SIGTERM; treat that as a clean stop.
SuccessExitStatus=143
TimeoutStopSec=45
Restart=on-failure
UMask=0077

[Install]
WantedBy=multi-user.target
